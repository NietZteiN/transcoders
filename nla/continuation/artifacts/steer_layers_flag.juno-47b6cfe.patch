+def _apply_seed(seed: Optional[int]) -> None:
+    """artifact-fix: seed every RNG that can affect generation. See main.py's copy.
+
+    **Deliberately duplicated rather than imported.** This file is itself named `main.py`, so
+    `from main import _apply_seed` is ambiguous: which module wins depends on whether
+    `artifact/` precedes `artifact/obfuscation/` on `sys.path`. The guard at the top of this
+    file only inserts PROJECT_ROOT `if str(PROJECT_ROOT) not in sys.path` — and the matrix
+    worker already puts the repo on PYTHONPATH, so the insert is skipped, the script directory
+    stays first, and `import main` resolves to *this file*, which then re-imports itself and
+    dies with a partially-initialized-module ImportError. That is exactly what happened: all
+    90 B0 units failed rc=1 on attempt 1. Ten duplicated lines are cheaper than an import whose
+    target depends on the caller's environment.
+    """
+    if seed is None:
+        return
+    import random as _random
+
+    import numpy as _np
+    _random.seed(seed)
+    _np.random.seed(seed % (2 ** 32))
+    torch.manual_seed(seed)
+    if torch.cuda.is_available():
+        torch.cuda.manual_seed_all(seed)
+    print(f"[artifact-fix] seeded torch/numpy/random with {seed}")
+
+
